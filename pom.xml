<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vexelray.sim</groupId>
    <artifactId>vexelray-sim-physics</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>vexelray-sim-physics</name>
    <description>
        Physics for VexelRay, and the front door to its simulations: the fluid and the rigid bodies coupled both
        ways, stepped as one. Bodies feel buoyancy and drag, and the fluid feels the bodies as moving boundaries.
        An application that wants physics depends on this, not on the simulations under it.
    </description>

    <modules>
        <!-- The coupling as SupirVast IR, and the passes of both simulations ordered into one step. No engine, no
             window. -->
        <module>vexelray-sim-physics-core</module>
        <!-- The coupled step on the VexelRay stack: one runner over both simulations' resident buffers. -->
        <module>vexelray-sim-physics-gui</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- The stack, installed to the local .m2 from the sibling checkouts. -->
        <supirvast.version>0.2.0-SNAPSHOT</supirvast.version>
        <vexelray.gui.version>0.1.0-SNAPSHOT</vexelray.gui.version>
        <vexelray.sim.core.version>0.1.0-SNAPSHOT</vexelray.sim.core.version>
        <vexelray.sim.fluid.version>0.1.0-SNAPSHOT</vexelray.sim.fluid.version>
        <vexelray.sim.rigid.version>0.1.0-SNAPSHOT</vexelray.sim.rigid.version>

        <junit.version>5.11.4</junit.version>

        <!-- Tests tagged "physics" run seconds of simulated time and judge what happened; they take minutes,
             so a build leaves them out. mvn test -Pphysics runs them as well. -->
        <test.excludedGroups>physics</test.excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Reactor-internal modules: children reference these without a version. -->
            <dependency>
                <groupId>dev.vexelray.sim</groupId>
                <artifactId>vexelray-sim-physics-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- The simulations coupled, from the sibling checkouts. -->
            <dependency>
                <groupId>dev.vexelray.sim</groupId>
                <artifactId>vexelray-sim-fluid-core</artifactId>
                <version>${vexelray.sim.fluid.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.sim</groupId>
                <artifactId>vexelray-sim-fluid-gui</artifactId>
                <version>${vexelray.sim.fluid.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.sim</groupId>
                <artifactId>vexelray-sim-rigid-core</artifactId>
                <version>${vexelray.sim.rigid.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.sim</groupId>
                <artifactId>vexelray-sim-rigid-gui</artifactId>
                <version>${vexelray.sim.rigid.version}</version>
            </dependency>

            <!-- What the simulations share. -->
            <dependency>
                <groupId>dev.vexelray.sim</groupId>
                <artifactId>vexelray-sim-core</artifactId>
                <version>${vexelray.sim.core.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.sim</groupId>
                <artifactId>vexelray-sim-core-gui</artifactId>
                <version>${vexelray.sim.core.version}</version>
            </dependency>

            <dependency>
                <groupId>dev.supirvast</groupId>
                <artifactId>vastir</artifactId>
                <version>${supirvast.version}</version>
            </dependency>
            <!-- The CPU backend that runs the IR, and the accelerator that runs it on the GPU. -->
            <dependency>
                <groupId>dev.supirvast</groupId>
                <artifactId>vast</artifactId>
                <version>${supirvast.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.supirvast</groupId>
                <artifactId>vastir-tools</artifactId>
                <version>${supirvast.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-core</artifactId>
                <version>${vexelray.gui.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <!-- Explicit release on the plugin as well as the property, so IDEs pick up the Java 25
                         language level reliably. Same as the sibling repos. -->
                    <configuration>
                        <target>${maven.compiler.release}</target>
                        <release>${maven.compiler.release}</release>
                        <compilerArgs>
                            <arg>-Xdoclint:reference,syntax</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <excludedGroups>${test.excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>physics</id>
            <properties>
                <test.excludedGroups />
            </properties>
        </profile>
        <!-- On Linux the build goes to target-linux/, not target/: the Windows host and a Linux VM build the same checkout
             (a shared folder), and each keeps its own output beside the other's instead of overwriting it. -->
        <profile>
            <id>linux-build-output</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <directory>${project.basedir}/target-linux</directory>
            </build>
        </profile>
    </profiles>
</project>
